table Daily_Production_Log
	lineageTag: fdaba09d-3bfe-4adc-999f-df4d088c1eef

	measure 'Total Sales' = SUM(Sales_Transactions[Revenue_EGP])
		lineageTag: fc5f1d73-90a3-43f8-97cf-4e226fab2a33

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Quantity' =
			
			SUM(Sales_Transactions[Quantity_Tons])
		lineageTag: 07f65893-e502-4e8f-aebc-1e10c38d97d0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Customers' =
			
			DISTINCTCOUNT(Sales_Transactions[Customer_ID])
		formatString: 0
		lineageTag: c3156542-c03a-4103-95b4-3351a94c4ab5

	measure 'Export Sales' =
			
			CALCULATE(
			    [Total Sales],
			    Sales_Transactions[Is_Export] = "Yes"
			)
		lineageTag: c18cbb1e-640c-448d-95cc-a505f418f602

		annotation PBI_FormatHint = {"isGeneralNumber":true}

